DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT_ID.supabase.co:5432/postgres
 
# Optional YantrikDB cluster health (enterprise routing). Leave empty to disable.
YANTRIK_DB_URL=
YANTRIK_DB_API_KEY=

# Optional Langfuse routing telemetry (mcp.route_decision.v1). Leave keys empty to disable.
WISEPICK_LANGFUSE_PUBLIC_KEY=
WISEPICK_LANGFUSE_SECRET_KEY=
WISEPICK_LANGFUSE_HOST=https://cloud.langfuse.com


# WISEPICK_LANGFUSE_OTEL=false
# WISEPICK_LANGFUSE_ROUTER_NAME=wisepick

# Supabase PostgreSQL connection URL
# 如果你的服务器在 IPv4-only 网络（如中国大陆部分 VPS），请使用 Session Pooler 连接
# 格式 / Format:
# postgresql://postgres.YOUR_USER:[YOUR_PASSWORD]@YOUR_PROJECT.pooler.supabase.com:5432/postgres
#
# 例如：
# postgresql://postgres.pidlczfjdrkdktbfcmci:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# YOUR_PASSWORD: 创建 Supabase 项目时设置的数据库密码
# YOUR_USER: Supabase 自动生成的用户名
# YOUR_PROJECT.pooler.supabase.com: Session Pooler 域名
# DATABASE_URL=postgresql://postgres.YOUR_USER:YOUR_PASSWORD@YOUR_PROJECT.pooler.supabase.com:5432/postgres