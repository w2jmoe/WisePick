DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT_ID.supabase.co:5432/postgres

# Optional YantrikDB cluster health (enterprise routing). Leave empty to disable.
YANTRIK_DB_URL=
YANTRIK_DB_API_KEY=

# Optional Langfuse routing telemetry (mcp.route_decision.v1). Leave keys empty to disable.
WISEPICK_LANGFUSE_PUBLIC_KEY=
WISEPICK_LANGFUSE_SECRET_KEY=
WISEPICK_LANGFUSE_HOST=https://cloud.langfuse.com
# WISEPICK_LANGFUSE_OTEL=false
# WISEPICK_LANGFUSE_ROUTER_NAME=wisepick

# Supabase PostgreSQL connection URL
# Supabase PostgreSQL 连接地址
#
# Format / 格式:
# postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
#
# YOUR_PASSWORD:
# The database password you created when setting up the Supabase project.
# 创建 Supabase 项目时自己设置的数据库密码。
#
# YOUR_PROJECT_ID:
# To find Project ID: Supabase Project > Project Settings (gear icon) > General settings > Project ID.
# 获取Project ID路径：打开你的 Supabese项目 - 点击左侧齿轮 Project Settings - General settings - Project ID.
#
# Example / 示例:
# abcdefghijklmnop
#
# Create project / 创建项目: 
# https://supabase.com
